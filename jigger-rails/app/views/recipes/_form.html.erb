<%= form_with model: recipe, class: "recipe-form recipe-editor-form" do |form| %>
  <% if recipe.errors.any? %>
    <div role="alert" class="library-errors"><strong>Check your recipe details</strong><ul><% recipe.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div>
  <% end %>
  <section class="recipe-editor-section" aria-labelledby="recipe-basics-title">
    <div class="recipe-section-intro"><h2 id="recipe-basics-title">The basics</h2><p>Give your drink a name and a little character.</p></div>
    <div class="recipe-section-fields">
      <div><%= form.label :name, "Recipe name" %><%= form.text_field :name, placeholder: "e.g. My Sunday Negroni" %></div>
      <div><%= form.label :language %><%= form.text_field :language, aria: { describedby: "recipe-language-help" } %><small id="recipe-language-help">The language you’re writing in, such as en for English or ja for Japanese.</small></div>
      <div class="recipe-editor-row"><div><%= form.label :servings %><%= form.number_field :servings, min: 1, step: 1 %></div><div><%= form.label :preparation_method %><%= form.select :preparation_method, options_for_select([["Choose a method", nil]] + Recipe.preparation_methods.keys.map { |value| [value.humanize, value] }, recipe.preparation_method) %></div></div>
    </div>
  </section>
  <section class="recipe-editor-section" aria-labelledby="recipe-preparation-title">
    <div class="recipe-section-intro"><h2 id="recipe-preparation-title">Preparation</h2><p>Make it easy to get every pour right.</p></div>
    <div class="recipe-section-fields">
      <p class="recipe-editor-note">Ingredient and utensil editing isn’t available in this form yet. <%= recipe.recipe_ingredients.any? ? "Your existing requirements are preserved." : "Save your idea as a draft; publishing requires ingredient lines." %></p>
      <% multi_step = recipe.recipe_steps.reject(&:marked_for_destruction?).size > 1 %>
      <div><%= form.label :steps, "Preparation steps" %><% if multi_step %><p id="recipe-steps-help" class="recipe-editor-note">This recipe has multiple steps. They’re shown here for reference and can’t be changed in this editor yet.</p><% end %><%= form.textarea :steps, rows: 6, readonly: multi_step, placeholder: "Add the ingredients, stir with ice, and strain…", aria: { describedby: ("recipe-steps-help" if multi_step) } %></div>
      <fieldset class="technique-options" aria-describedby="recipe-techniques-help">
        <legend>Techniques used</legend>
        <p id="recipe-techniques-help">Choose all that appear in your steps. Readers can open a beginner guide for each one.</p>
        <% techniques = Technique.includes(:translations).order(:slug) %>
        <% if techniques.any? %>
          <div class="technique-options-list">
            <%= form.collection_check_boxes :technique_ids, techniques, :id, :display_name do |choice| %>
              <%= choice.label { choice.check_box + choice.text } %>
            <% end %>
          </div>
        <% else %>
          <p>No technique guides are available yet.</p>
        <% end %>
      </fieldset>
      <div><%= form.label :preparation_time_seconds, "Preparation time (seconds)" %><%= form.number_field :preparation_time_seconds, min: 0, step: 1, placeholder: "e.g. 120" %></div>
    </div>
  </section>
  <section class="recipe-editor-section" aria-labelledby="recipe-photo-title">
    <div class="recipe-section-intro"><h2 id="recipe-photo-title">A photo to remember</h2><p>Optional, but a good drink deserves a good close-up.</p></div>
    <div class="recipe-section-fields"><div class="recipe-photo-field">
      <% if recipe.persisted? && recipe.image.attached? %><%= image_tag recipe_image_path(recipe, size: :card), alt: "Current photo of #{recipe.display_name}", loading: "lazy", class: "recipe-editor-photo" %><% end %>
      <%= form.label :image, recipe.image.attached? ? "Replace photo" : "Add a photo" %><%= form.file_field :image, accept: "image/jpeg,image/png,image/webp", aria: { describedby: "image-help" } %><small id="image-help">JPEG, PNG or WebP. Up to 10 MB and 25 megapixels.<%= " Your current photo stays unless you choose a replacement." if recipe.image.attached? %></small>
    </div></div>
  </section>
  <section class="recipe-editor-section" aria-labelledby="recipe-sharing-title">
    <div class="recipe-section-intro"><h2 id="recipe-sharing-title">Saving &amp; sharing</h2><p>Keep an idea to yourself or share the finished recipe.</p></div>
    <div class="recipe-section-fields">
      <div><%= form.label :publication_state, "Recipe status" %><%= form.select :publication_state, [["Draft", "draft"], ["Published", "published"]], {}, aria: { describedby: "recipe-state-help" } %><small id="recipe-state-help">Drafts are only visible to you. Publishing requires a name, language, ingredients, and preparation steps.</small></div>
      <div><%= form.label :visibility, "Visibility" %><%= form.select :visibility, [["Private — only you", "private"], ["Public — visible when published", "public"]], {}, aria: { describedby: "recipe-visibility-help" } %><small id="recipe-visibility-help">A recipe appears in Explore when it’s public and published.</small></div>
    </div>
  </section>
  <details class="recipe-editor-extra"><summary>Source &amp; inspiration <span>Optional</span></summary><div class="recipe-section-fields"><div><%= form.label :source_reference, "Source or credit" %><%= form.text_field :source_reference, placeholder: "A book, a bartender, an inspiration…" %></div><div><%= form.label :source_url, "Source link" %><%= form.url_field :source_url, placeholder: "https://" %></div></div></details>
  <% if Current.user&.admin? %>
    <details class="recipe-editor-extra"><summary>Catalog settings</summary><div class="recipe-section-fields"><div><%= form.label :cocktail_id, "Canonical cocktail (leave blank for an original)" %><%= form.collection_select :cocktail_id, Cocktail.includes(:translations).to_a.sort_by { |cocktail| cocktail.display_name.to_s }, :id, :display_name, include_blank: "Unassigned" %></div></div></details>
  <% end %>
  <div class="recipe-editor-actions"><%= form.submit recipe.persisted? ? "Save changes" : "Create recipe", class: "library-primary", data: { turbo_submits_with: "Saving…" } %><%= link_to "Cancel", recipe.persisted? ? recipe_path(recipe) : my_recipes_path, class: "library-cancel" %></div>
<% end %>
