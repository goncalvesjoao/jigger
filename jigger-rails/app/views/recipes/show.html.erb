<% content_for :title, "#{@recipe.display_name} · Jigger" %>
<%= link_to "← All recipes", cocktails_path, class: "back-link" %>
<% Globalize.with_locale(@recipe.language == "und" ? I18n.default_locale : @recipe.language) do %>
<article class="recipe" lang="<%= @recipe.language %>">
  <header class="recipe-hero">
    <div class="recipe-intro">
      <p class="eyebrow"><%= @recipe.official? ? "Official Jigger recipe" : @recipe.user_id.present? ? "Community recipe" : "From our collection" %></p>
      <h1><%= @recipe.display_name %></h1>
      <% if @recipe.cocktail && policy(@recipe.cocktail).show? %><p>Cocktail: <%= link_to @recipe.cocktail.display_name, @recipe.cocktail %></p><% end %>
      <dl class="recipe-facts">
        <% if @recipe.servings.present? %><div><dt>Servings</dt><dd><%= @recipe.servings %></dd></div><% end %>
        <% if @recipe.preparation_method.present? %><div><dt>Method</dt><dd><%= @recipe.preparation_method.humanize %></dd></div><% end %>
        <% if @recipe.preparation_time_seconds.present? %><div><dt>Preparation</dt><dd><%= @recipe.preparation_time_seconds %> <small>sec</small></dd></div><% end %>
      </dl>
      <a href="#ingredients" class="button">Start mixing ↓</a>
    </div>
    <% if @recipe.image.attached? %><%= image_tag recipe_image_path(@recipe, size: :detail), alt: "Photo of #{@recipe.name}", class: "recipe-photo" %><% else %><div class="recipe-photo photo-placeholder" aria-hidden="true">J.</div><% end %>
  </header>
  <div class="mixing-layout">
    <%= render "requirements", recipe: @recipe %>
    <section id="preparation" class="card recipe-panel mb-0" data-controller="preparation">
      <p class="eyebrow">02 / Make</p><h2>Preparation</h2>
      <a href="#ingredients">← Back to ingredients</a>
      <% if @recipe.recipe_steps.any? %>
        <div class="mixing-progress mt-4" data-preparation-target="status" hidden>
          <p data-preparation-target="summary" role="status" aria-live="polite"></p>
          <progress data-preparation-target="progress" value="0" max="<%= @recipe.recipe_steps.size %>" aria-label="Preparation progress"></progress>
          <button type="button" class="ghost" data-action="preparation#reset">Reset steps</button>
        </div>
        <ol class="checklist steps-list">
          <% @recipe.recipe_steps.each_with_index do |step, index| %>
            <li><label><input type="checkbox" data-preparation-target="step" data-action="preparation#update"><span><span class="step-number">Step <%= index + 1 %></span><span class="submitted-prose step-body"><%= step.body %></span></span></label></li>
          <% end %>
        </ol>
      <% else %><p>No preparation steps listed.</p><% end %>
    </section>
  </div>
  <footer class="recipe-footer">
    <section><h2>Recipe notes</h2>
      <% if @recipe.source_url.present? %><p>Source: <%= link_to @recipe.source_reference.presence || "Recipe source", @recipe.source_url %></p><% elsif @recipe.source_reference.present? %><p class="submitted-prose"><%= @recipe.source_reference %></p><% end %>
    </section>
    <div class="recipe-actions">
      <% if policy(@recipe).edit? %><%= link_to "Edit this recipe", edit_recipe_path(@recipe) %><% end %>
      <% if policy(@recipe).destroy? %><%= button_to "Destroy this recipe", @recipe, method: :delete, class: "ghost danger", data: { turbo_confirm: "Delete this recipe? This cannot be undone." } %><% end %>
    </div>
  </footer>
</article>
<% end %>
