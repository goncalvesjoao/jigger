<% content_for :title, "Discover recipes · Jigger" %>
<section class="discovery-heading">
  <p class="eyebrow">The recipe collection</p>
  <h1>A little inspiration.<br>A great next drink.</h1>
  <p>Find a recipe, gather your ingredients, make it your own.</p>
  <%= form_with url: recipes_path, method: :get, class: "search-form" do |form| %>
    <%= form.label :q, "Search recipes" %>
    <div role="search">
      <%= form.search_field :q, value: params[:q], placeholder: "Find your next recipe…" %>
      <%= form.submit "Search" %>
    </div>
  <% end %>
</section>
<div class="section-heading"><h2 class="mb-0"><%= params[:q].present? ? "Search results" : "Discover the collection" %></h2><span><%= pluralize(@recipes.size, "recipe") %></span></div>
<% if @recipes.empty? %>
  <section class="empty-state"><h3>No recipes found.</h3><p>Try a different name or explore the collection.</p><%= link_to "All recipes", recipes_path %></section>
<% end %>
<div id="recipes" class="auto-grid recipe-grid">
  <%= render @recipes %>
</div>
