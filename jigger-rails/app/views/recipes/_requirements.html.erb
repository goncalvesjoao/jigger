<section id="<%= ingredients_id %>" class="card recipe-panel ingredients-panel mb-0" data-controller="ingredients">
  <p class="eyebrow">01 / Gather</p>
  <div class="ingredients-heading">
    <h2>Ingredients</h2>
    <% if recipe.servings.present? %><span class="recipe-servings"><%= pluralize(recipe.servings, "serving") %></span><% end %>
  </div>
  <progress class="checklist-progress" data-ingredients-target="progress" value="0" max="<%= [recipe.recipe_ingredients.size, 1].max %>" aria-label="Ingredients gathered" hidden></progress>
  <% if recipe.recipe_ingredients.any? %>
    <ul class="checklist ingredient-list">
      <% recipe.recipe_ingredients.each do |line| %>
        <li><label>
          <input type="checkbox" data-ingredients-target="item" data-action="ingredients#update">
          <span class="ingredient-copy">
            <% if line.quantity.present? %><strong class="quantity"><%= number_with_precision(line.quantity, precision: 3, strip_insignificant_zeros: true) %> <%= line.measuring_unit %></strong><% end %>
            <span class="submitted-prose" lang="<%= line.language %>"><%= line.submitted_text %></span>
            <% if line.preparation_note.present? %><small><%= line.preparation_note %></small><% end %>
            <% if line.optional? %><small>Optional</small><% end %>
            <% unless line.mixing? %><small><%= line.role.humanize %></small><% end %>
          </span>
          <% if line.ingredient.image.attached? %><%= image_tag ingredient_image_path(line.ingredient, size: :card), alt: "Photo of #{line.ingredient.name}", loading: "lazy", class: "requirement-photo" %><% end %>
        </label></li>
      <% end %>
    </ul>
  <% else %><p>No ingredients listed.</p><% end %>
  <% if recipe.recipe_utensils.any? %>
    <h3>Utensils</h3>
    <ul class="utensil-list">
      <% recipe.recipe_utensils.each do |requirement| %>
        <li><span class="submitted-prose" lang="<%= requirement.language %>"><%= requirement.submitted_text %></span>
          <% if requirement.utensil.image.attached? %><%= image_tag utensil_image_path(requirement.utensil, size: :card), alt: "Photo of #{requirement.utensil.name}", loading: "lazy", class: "requirement-photo" %><% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
  <div class="ingredients-footer"><a href="#<%= preparation_id %>">Go to preparation →</a></div>
</section>
