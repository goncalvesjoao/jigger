<%= form_with model: page.resource, url: [namespace, page.resource], local: true, class: "form" do |f| %>
  <% if page.resource.errors.any? %>
    <div role="alert" id="error_explanation">
      <h2>Please correct these errors</h2>
      <ul><% page.resource.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>
  <% page.attributes(controller.action_name).each do |title, attributes| %>
    <fieldset>
      <% if title.present? %><legend><%= title %></legend><% end %>
      <% attributes.each do |attribute| %>
        <div class="field-unit field-unit--<%= attribute.html_class %>"><%= render_field attribute, f: f %></div>
      <% end %>
    </fieldset>
  <% end %>
  <div class="form-actions"><%= f.submit %></div>
<% end %>
