<% content_for :title, "#{@collection.name} · Jigger" %>
<% owned = Current.user == @collection.user %>
<div class="library-page">
  <%= link_to owned ? my_collections_path : cocktails_path, class: "library-back" do %><%= render "icon", name: "back" %><%= owned ? "My collections" : "Explore recipes" %><% end %>
  <header class="library-detail-heading">
    <%= render "artwork", collection: @collection, recipes: @recipes.first(4) %>
    <div class="library-detail-copy"><p class="eyebrow"><%= owned ? "Your collection" : "Recipe collection" %></p><h1><%= @collection.name %></h1>
      <% if @collection.user.public_profile? %><p class="profile-byline">Collected by <%= link_to @collection.user.profile_name, profile_path(@collection.user) %></p><% end %>
      <div class="library-detail-meta"><span class="library-visibility"><%= render "icon", name: @collection.visibility %><%= @collection.visibility.capitalize %></span><span><%= pluralize(@recipes.size, "recipe") %></span></div>
      <p class="library-description"><%= @collection.visibility == "private" ? "Just for you. Only you can see this collection." : "Made to share. Anyone with the link can view this collection." %></p>
      <% if owned %><%= link_to edit_collection_path(@collection), class: "button library-secondary" do %><%= render "icon", name: "edit" %>Edit collection<% end %><% end %>
    </div>
  </header>
  <% if @recipes.empty? %>
    <section class="library-empty"><span class="library-empty-symbol"><%= render "icon", name: "plus" %></span><h2><%= owned ? "Your next favorite belongs here." : "No recipes to show yet." %></h2><p><%= owned ? "Explore a recipe, tap + on its image, and choose this collection." : "Come back to see what’s added next." %></p><%= link_to "Explore recipes", cocktails_path, class: "button library-primary" %></section>
  <% else %>
    <div class="library-section-label"><h2>Recipes</h2><span>Recently added first</span></div>
    <div class="auto-grid recipe-grid library-recipes">
      <% @recipes.each do |recipe| %>
        <div class="library-recipe"><%= render recipe %>
          <% if owned %><%= button_to "Remove from collection", collection_collection_recipe_path(@collection, recipe), method: :delete, class: "library-remove", aria: { label: "Remove #{recipe.display_name} from #{@collection.name}" } %><% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
