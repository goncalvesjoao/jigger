<% content_for :title, "#{@collection.name} · Jigger" %>
<h1><%= @collection.name %></h1>
<p><%= @collection.visibility.capitalize %></p>
<% if Current.user == @collection.user %>
  <%= link_to "Edit collection", edit_collection_path(@collection) %>
  <%= button_to "Delete collection", @collection, method: :delete, data: { turbo_confirm: "Delete this collection?" } %>
<% end %>
<% if @recipes.empty? %><p>No recipes to show yet. Add recipes from a recipe page.</p><% end %>
<div class="auto-grid recipe-grid">
<% @recipes.each do |recipe| %>
  <div><%= render recipe %>
  <% if Current.user == @collection.user %><%= button_to "Remove from collection", collection_collection_recipe_path(@collection, recipe), method: :delete %><% end %></div>
<% end %>
</div>
