<div id="<%= dom_id user_cocktail %>">
  <div>
    <strong>Name:</strong>
    <%= user_cocktail.name %>
  </div>

  <div>
    <strong>Steps:</strong>
    <%= user_cocktail.steps %>
  </div>

  <div>
    <strong>Preparation time seconds:</strong>
    <%= user_cocktail.preparation_time_seconds %>
  </div>

  <div>
    <strong>User:</strong>
    <%= user_cocktail.user_id %>
  </div>

</div>
