<%= form_with(model: user_cocktail) do |form| %>
  <% if user_cocktail.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(user_cocktail.errors.count, "error") %> prohibited this cocktail from being saved:</h2>

      <ul>
        <% user_cocktail.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :language, style: "display: block" %>
    <%= form.text_field :language %>
  </div>

  <% if user_cocktail.recipe_steps.reject(&:marked_for_destruction?).size > 1 %>
    <p>This recipe has multiple preparation steps. Editing them here is not supported yet.</p>
  <% end %>

  <div>
    <%= form.label :steps, style: "display: block" %>
    <%= form.textarea :steps, readonly: user_cocktail.recipe_steps.reject(&:marked_for_destruction?).size > 1 %>
  </div>

  <div>
    <%= form.label :preparation_time_seconds, style: "display: block" %>
    <%= form.number_field :preparation_time_seconds %>
  </div>

  <div>
    <%= form.label :servings, style: "display: block" %>
    <%= form.number_field :servings, min: 1, step: 1 %>
  </div>

  <div>
    <%= form.label :preparation_method, style: "display: block" %>
    <%= form.select :preparation_method, options_for_select([ [ "", nil ] ] + UserCocktail.preparation_methods.keys.map { |value| [ value.humanize, value ] }, user_cocktail.preparation_method) %>
  </div>

  <div>
    <%= form.label :source_reference, style: "display: block" %>
    <%= form.text_field :source_reference %>
  </div>

  <div>
    <%= form.label :image, "Photo" %>
    <%= form.file_field :image, accept: "image/jpeg,image/png,image/webp", aria: { describedby: "image-help" } %>
    <p id="image-help">Optional JPEG, PNG or WebP photo. Maximum 10 MB and 25 megapixels. Choose a new photo to replace the current one.</p>
    <% if user_cocktail.persisted? && user_cocktail.image.attached? %>
      <%= image_tag user_cocktail_image_path(user_cocktail, size: :card), alt: "Current photo of #{user_cocktail.name}", loading: "lazy" %>
    <% end %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
