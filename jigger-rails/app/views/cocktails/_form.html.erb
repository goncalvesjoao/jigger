<%= form_with(model: cocktail) do |form| %>
  <% if cocktail.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(cocktail.errors.count, "error") %> prohibited this cocktail from being saved:</h2>

      <ul>
        <% cocktail.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :steps, style: "display: block" %>
    <%= form.textarea :steps %>
  </div>

  <div>
    <%= form.label :preparation_time_seconds, style: "display: block" %>
    <%= form.number_field :preparation_time_seconds %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
