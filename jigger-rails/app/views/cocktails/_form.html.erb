<%= form_with(model: cocktail, class: "recipe-form") do |form| %>
  <% if cocktail.errors.any? %>
    <div role="alert" class="text-danger">
      <h2><%= pluralize(cocktail.errors.count, "error") %> prohibited this cocktail from being saved:</h2>

      <ul>
        <% cocktail.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :language %>
    <%= form.text_field :language %>
  </div>

  <% if cocktail.recipe_steps.reject(&:marked_for_destruction?).size > 1 %>
    <p>This recipe has multiple preparation steps. Editing them here is not supported yet.</p>
  <% end %>

  <div>
    <%= form.label :steps %>
    <%= form.textarea :steps, readonly: cocktail.recipe_steps.reject(&:marked_for_destruction?).size > 1 %>
  </div>

  <div>
    <%= form.label :preparation_time_seconds %>
    <%= form.number_field :preparation_time_seconds %>
  </div>

  <div>
    <%= form.label :servings %>
    <%= form.number_field :servings, min: 1, step: 1 %>
  </div>

  <div>
    <%= form.label :preparation_method %>
    <%= form.select :preparation_method, options_for_select([ [ "", nil ] ] + Cocktail.preparation_methods.keys.map { |value| [ value.humanize, value ] }, cocktail.preparation_method) %>
  </div>

  <div>
    <%= form.label :source_reference %>
    <%= form.text_field :source_reference %>
  </div>

  <div>
    <%= form.label :source_url %>
    <%= form.url_field :source_url %>
    <%= form.label :source_published_on, "Original publication date" %>
    <%= form.date_field :source_published_on %>
    <%= form.label :source_date_note, "Historical date notes" %>
    <%= form.text_area :source_date_note %>
    <%= form.label :visibility %>
    <%= form.select :visibility, %w[private public] %>
    <%= form.label :publication_state %>
    <%= form.select :publication_state, %w[draft published] %>
    <% if Current.user&.admin? %>
      <%= form.label :official, "Official Jigger recipe" %>
      <%= form.check_box :official %>
    <% end %>
  </div>

  <div>
    <%= form.label :image, "Photo" %>
    <%= form.file_field :image, accept: "image/jpeg,image/png,image/webp", aria: { describedby: "image-help" } %>
    <p id="image-help">Optional JPEG, PNG or WebP photo. Maximum 10 MB and 25 megapixels. Choose a new photo to replace the current one.</p>
    <% if cocktail.persisted? && cocktail.image.attached? %>
      <%= image_tag cocktail_image_path(cocktail, size: :card), alt: "Current photo of #{cocktail.name}", loading: "lazy" %>
    <% end %>
  </div>

  <div>
    <%= form.submit class: "w-auto mt-3" %>
  </div>
<% end %>
