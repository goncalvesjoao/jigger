<% content_for :title, "#{@cocktail.display_name} · Jigger" %>
<%= link_to "← All cocktails", cocktails_path, class: "back-link" %>
<% Globalize.with_locale(@cocktail.language == "und" ? I18n.default_locale : @cocktail.language) do %>
<article class="recipe" lang="<%= @cocktail.language %>">
  <header class="recipe-hero">
    <div class="recipe-intro">
      <p class="eyebrow"><%= @cocktail.official? ? "Official Jigger recipe" : @cocktail.user_id.present? ? "Community recipe" : "From our collection" %></p>
      <h1><%= @cocktail.display_name %></h1>
      <% if @cocktail.description.present? %><p class="submitted-prose recipe-description"><%= @cocktail.description %></p><% end %>
      <dl class="recipe-facts">
        <% if @cocktail.servings.present? %><div><dt>Servings</dt><dd><%= @cocktail.servings %></dd></div><% end %>
        <% if @cocktail.preparation_method.present? %><div><dt>Method</dt><dd><%= @cocktail.preparation_method.humanize %></dd></div><% end %>
        <% if @cocktail.preparation_time_seconds.present? %><div><dt>Preparation</dt><dd><%= @cocktail.preparation_time_seconds %> <small>sec</small></dd></div><% end %>
      </dl>
      <a href="#ingredients" class="button">Start mixing ↓</a>
    </div>
    <% if @cocktail.image.attached? %><%= image_tag cocktail_image_path(@cocktail, size: :detail), alt: "Photo of #{@cocktail.name}", class: "recipe-photo" %><% else %><div class="recipe-photo photo-placeholder" aria-hidden="true">J.</div><% end %>
  </header>
  <div class="mixing-layout">
    <%= render "requirements", cocktail: @cocktail %>
    <section id="preparation" class="card recipe-panel mb-0" data-controller="preparation">
      <p class="eyebrow">02 / Make</p><h2>Preparation</h2>
      <a href="#ingredients">← Back to ingredients</a>
      <% if @cocktail.recipe_steps.any? %>
        <div class="mixing-progress mt-4" data-preparation-target="status" hidden>
          <p data-preparation-target="summary" role="status" aria-live="polite"></p>
          <progress data-preparation-target="progress" value="0" max="<%= @cocktail.recipe_steps.size %>" aria-label="Preparation progress"></progress>
          <button type="button" class="ghost" data-action="preparation#reset">Reset steps</button>
        </div>
        <ol class="checklist steps-list">
          <% @cocktail.recipe_steps.each_with_index do |step, index| %>
            <li><label><input type="checkbox" data-preparation-target="step" data-action="preparation#update"><span><span class="step-number">Step <%= index + 1 %></span><span class="submitted-prose step-body"><%= step.body %></span></span></label></li>
          <% end %>
        </ol>
      <% else %><p>No preparation steps listed.</p><% end %>
    </section>
  </div>
  <footer class="recipe-footer">
    <section><h2>Recipe notes</h2>
      <% if @cocktail.source_url.present? %><p>Source: <%= link_to @cocktail.source_reference.presence || "Recipe source", @cocktail.source_url %></p><% elsif @cocktail.source_reference.present? %><p class="submitted-prose"><%= @cocktail.source_reference %></p><% end %>
      <% if @cocktail.source_published_on.present? %><p>Original publication: <%= @cocktail.source_published_on %></p><% end %>
      <% if @cocktail.source_date_note.present? %><p class="submitted-prose"><%= @cocktail.source_date_note %></p><% end %>
      <% if @cocktail.parent_cocktail && policy(@cocktail.parent_cocktail).show? %><p>Adapted from <%= link_to @cocktail.parent_cocktail.display_name, @cocktail.parent_cocktail %></p><% end %>
      <% variants = @cocktail.variants.marketplace %>
      <% if variants.any? %><h3>Variants (<%= variants.size %>)</h3><ul><% variants.each do |variant| %><li><%= link_to variant.display_name, variant %></li><% end %></ul><% end %>
    </section>
    <div class="recipe-actions">
      <% if policy(@cocktail).edit? %><%= link_to "Edit this cocktail", edit_cocktail_path(@cocktail) %><% end %>
      <% if policy(@cocktail).destroy? %><%= button_to "Destroy this cocktail", @cocktail, method: :delete, class: "ghost danger", data: { turbo_confirm: "Delete this cocktail? This cannot be undone." } %><% end %>
    </div>
  </footer>
</article>
<% end %>
