<header class="detail-hero recipe-hero">
  <div class="recipe-intro">
    <% unless recipe %>
      <nav class="cocktail-breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><%= link_to "Cocktails", cocktails_path(request.query_parameters.slice("q", "ingredient_ids", "utensil_ids", "makeable", "ingredient_mode", "utensil_mode")), class: "back-link" %></li>
          <li aria-current="page"><%= cocktail.display_name %></li>
        </ol>
      </nav>
    <% end %>

    <h1><%= recipe ? recipe_heading(recipe) : cocktail.display_name %></h1>

    <% if recipe && !(recipe.publication_state == "published" && recipe.visibility == "public") %><p class="recipe-attribution"><%= recipe.publication_state.capitalize %> · <%= recipe.visibility.capitalize %></p><% end %>
    <% if recipe&.user&.public_profile? %><p class="detail-parent">Recipe by <%= link_to recipe.user.profile_name, profile_path(recipe.user) %></p><% end %>
    <% if recipe && cocktail %><p class="detail-parent">A recipe for <%= link_to cocktail.display_name, cocktail_path(cocktail) %></p><% end %>
    <% if !recipe && cocktail&.description.present? %><p class="detail-description submitted-prose"><%= cocktail.description %></p><% end %>
    <% unless recipe %><%= render "cocktails/section_nav", cocktail: cocktail, recipe_page: false %><% end %>
    <% if recipe %>
      <%= render "recipes/facts", recipe: recipe %>
    <% end %>
    <% if recipe %>
    <div class="detail-actions">
      <%= link_to "Start mixing ↓", "#ingredients", class: "button" %>
      <% if authenticated? %><%= render "recipes/star", recipe: recipe %><% end %>
    </div>
    <% end %>
  </div>
  <div class="detail-visual">
    <% photo = recipe ? recipe_photo(recipe) : cocktail %>
    <% if photo.image.attached? %>
      <%= image_tag public_send("#{photo.model_name.singular}_image_path", photo, size: :detail), alt: "Photo of #{photo.display_name}", class: "recipe-photo", fetchpriority: "high", width: 1200, height: 1200 %>
    <% else %>
      <div class="recipe-photo photo-placeholder" role="img" aria-label="No photo available">J.</div>
    <% end %>
    <% if recipe && authenticated? %><%= render "collections/picker", recipe: recipe %><% end %>

  </div>
</header>
