<div id="<%= dom_id cocktail %>">
  <div>
    <strong>Name:</strong>
    <%= cocktail.name %>
  </div>

  <div>
    <strong>Steps:</strong>
    <%= cocktail.steps %>
  </div>

  <div>
    <strong>Preparation time seconds:</strong>
    <%= cocktail.preparation_time_seconds %>
  </div>

  <div>
    <strong>User:</strong>
    <%= cocktail.user_id %>
  </div>

</div>
