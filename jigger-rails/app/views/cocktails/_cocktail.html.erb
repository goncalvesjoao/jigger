<% Globalize.with_locale(cocktail.language == "und" ? I18n.default_locale : cocktail.language) do %>
<article id="<%= dom_id cocktail %>" lang="<%= cocktail.language %>">
  <%= link_to cocktail, class: "card-image", tabindex: "-1", aria: { hidden: true } do %>
    <% if cocktail.image.attached? %>
      <%= image_tag cocktail_image_path(cocktail, size: :card), alt: "", loading: "lazy", srcset: "#{cocktail_image_path(cocktail, size: :card)} 320w, #{cocktail_image_path(cocktail, size: :detail)} 1200w", sizes: "(max-width: 36rem) calc(100vw - 2rem), (max-width: 55rem) calc((100vw - 4.3rem) / 2), (max-width: 81rem) calc((100vw - 7rem) / 3), 25rem" %>
    <% else %>
      <span class="photo-placeholder">J<span aria-hidden="true">.</span></span>
    <% end %>
  <% end %>
  <div class="card-copy">
    <p class="eyebrow"><%= cocktail.official? ? "Official Jigger recipe" : cocktail.user_id.present? ? "Community recipe" : "From our collection" %></p>
    <h3><%= link_to cocktail.display_name, cocktail %></h3>
    <% if cocktail.description.present? %><p class="card-description"><%= cocktail.description %></p><% end %>
    <% if cocktail.preparation_method.present? %>
      <div class="card-meta"><%= cocktail.preparation_method.humanize %></div>
    <% end %>
  </div>
</article>
<% end %>
