<% if cocktail.cocktail_ingredients.any? %>
  <h2>Ingredients</h2>
  <ul>
    <% cocktail.cocktail_ingredients.each do |line| %>
      <li>
        <span lang="<%= line.language %>"><%= line.submitted_text %></span>
        <% if line.ingredient.image.attached? %>
          <%= image_tag ingredient_image_path(line.ingredient, size: :card), alt: "Photo of #{line.ingredient.name}", loading: "lazy", style: "max-width: 100%; height: auto;" %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
<% if cocktail.cocktail_utensils.any? %>
  <h2>Utensils</h2>
  <ul>
    <% cocktail.cocktail_utensils.each do |requirement| %>
      <li>
        <span lang="<%= requirement.language %>"><%= requirement.submitted_text %></span>
        <% if requirement.utensil.image.attached? %>
          <%= image_tag utensil_image_path(requirement.utensil, size: :card), alt: "Photo of #{requirement.utensil.name}", loading: "lazy", style: "max-width: 100%; height: auto;" %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
