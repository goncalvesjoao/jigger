<% content_for :title, "Sign in · Jigger" %>
<section class="card form-page auth-page" aria-labelledby="sign-in-title">
  <h1 id="sign-in-title">Welcome back</h1>
  <p>Sign in to save drinks, organize collections, and work on your recipes.</p>
  <%= form_with url: session_path do |form| %>
    <%= form.label :email_address %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    <%= form.label :password %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
    <%= form.submit "Sign in", data: { turbo_submits_with: "Signing in…" } %>
  <% end %>
  <div class="auth-links"><%= link_to "Forgot password?", new_password_path %><%= link_to "Create an account", new_registration_path %></div>
</section>
