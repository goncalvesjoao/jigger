      "cocktail": "Margarita",
      "visibility": "public",
      "publication_state": "published",
      "ingredients": [
        [
          "Tequila",
          "45 ml tequila"
        ],
        [
          "Triple sec",
          "20 ml triple sec"
        ],
        [
          "Lime juice",
          "25 ml lime juice"
        ],
        [
          "Strawberries",
          "2 ripe strawberries"
        ]
      ],
