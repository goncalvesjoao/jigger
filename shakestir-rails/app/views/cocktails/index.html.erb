<% content_for :title, "Explore cocktails · ShakeStir" %>

<header class="explore-heading"><h1>Explore cocktails</h1><p>Discover canonical drinks and explore their recipes.</p></header>
<%= form_with url: cocktails_path, method: :get, class: "search-form" do |form| %>
  <%= form.label :q, "Search cocktails" %>
  <div role="search">
    <%= form.search_field :q, value: params[:q], placeholder: "Find a cocktail…" %>
    <%= form.submit "Search" %>
  </div>
<% end %>
<div id="marketplace-results" aria-live="polite">
<div class="section-heading marketplace-results"><h2><%= pluralize(@pagination.total_count, "cocktail") %></h2></div>
<% if @pagination.empty? %><section class="empty-state"><h3>No cocktails found.</h3><p>Try another name to find a cocktail.</p><%= link_to "All cocktails", cocktails_path %></section><% end %>
<%= turbo_frame_tag "cocktails_page_#{@pagination.current_page}", target: "_top" do %>
  <div id="cocktails_<%= @pagination.current_page %>" class="auto-grid recipe-grid">
    <%= render @pagination.to_a %>
  </div>
  <% if @pagination.next_page %>
    <% next_page_url = cocktails_path(request.query_parameters.merge("page" => @pagination.next_page)) %>
    <%= turbo_frame_tag "cocktails_page_#{@pagination.next_page}", src: next_page_url, loading: :lazy, target: "_top" do %>
      <p><%= link_to "Load more cocktails", next_page_url %></p>
    <% end %>
  <% end %>
<% end %>
</div>
