<header class="cocktail-cover<%= " cocktail-cover-with-photo" if cocktail.image.attached? %>">
  <% if cocktail.image.attached? %>
    <%= image_tag cocktail_image_path(cocktail, size: :detail), alt: "Photo of #{cocktail.display_name}", class: "cocktail-cover-photo", fetchpriority: "high", width: 1200, height: 1200 %>
  <% end %>
  <%= link_to cocktails_path(request.query_parameters.slice("q", "ingredient_ids", "utensil_ids", "makeable", "ingredient_mode", "utensil_mode")), class: "cocktail-cover-back" do %>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m14 6-6 6 6 6M8 12h12" /></svg>
    Back to cocktails
  <% end %>
  <div class="cocktail-cover-copy">
    <h1><%= cocktail.display_name %></h1>
    <% if cocktail.description.present? %><p class="cocktail-cover-description submitted-prose"><%= cocktail.description %></p><% end %>
    <p class="cocktail-cover-meta"><%= pluralize(@recipes.size, @filtered ? "matching recipe" : "recipe") %></p>
  </div>
</header>
