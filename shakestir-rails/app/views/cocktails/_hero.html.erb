<header class="position-relative d-flex align-items-end overflow-hidden cocktail-cover<%= " cocktail-cover-with-photo" if cocktail.image.attached? %>">
  <% if cocktail.image.attached? %>
    <%= image_tag cocktail_image_path(cocktail, size: :detail), alt: "Photo of #{cocktail.display_name}", class: "position-absolute w-100 h-100 object-fit-cover cocktail-cover-photo", fetchpriority: "high", width: 1200, height: 1200 %>
  <% end %>
  <%= link_to cocktails_path(request.query_parameters.slice("q", "ingredient_ids", "utensil_ids", "makeable", "ingredient_mode", "utensil_mode")), class: "d-inline-flex position-absolute align-items-center cocktail-cover-back secondary button" do %>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m14 6-6 6 6 6M8 12h12" /></svg>
    Back to cocktails
  <% end %>
  <div class="cocktail-cover-copy">
    <h1><%= cocktail.display_name %></h1>
    <% if cocktail.description.present? %><p class="m-0 cocktail-cover-description submitted-prose"><%= cocktail.description %></p><% end %>
  </div>
</header>
