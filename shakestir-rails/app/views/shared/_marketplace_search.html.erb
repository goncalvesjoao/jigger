<%= form_with url: root_path, method: :get, class: "position-relative marketplace-search", data: { controller: "marketplace-search", action: "keydown.esc->marketplace-search#close click@window->marketplace-search#dismiss submit->marketplace-search#submit" } do |form| %>
  <div class="d-grid align-items-center p-0 marketplace-search-bar" role="search" aria-label="Find recipes">
    <div class="position-relative marketplace-query">
      <%= form.label :q, "Search recipes", for: "marketplace-query" %>
      <%= form.search_field :q, id: "marketplace-query", value: params[:q], placeholder: "Try Negroni, sour, highball…", data: { action: "input->marketplace-search#search compositionend->marketplace-search#search" } %>
    </div>
    <% { ingredient_ids: ["Ingredients", Ingredient], utensil_ids: ["Utensils", Utensil] }.each do |key, (label, model)| %>
      <% mode_key = key == :ingredient_ids ? :ingredient_mode : :utensil_mode %>
      <% only_available = params[mode_key] == "only" || (!params.key?(mode_key) && params[:makeable] == "1") %>
      <%= hidden_field_tag mode_key, only_available ? "only" : "include" %>
      <% selected_count = Array(params[key]).reject(&:blank?).size %>
      <% items = model.usable.sort_by { |item| item.display_name.downcase } %>
      <details class="position-relative marketplace-picker" data-marketplace-search-target="picker" data-mode-key="<%= mode_key %>" data-action="toggle->marketplace-search#sync">
        <summary aria-controls="picker-<%= key %>">
          <span><strong><%= label %></strong><small data-picker-count><%= selected_count.positive? ? (only_available ? "#{selected_count} available · Only these" : "#{selected_count} selected") : "Add #{label.downcase}" %></small></span>
        </summary>
        <div class="marketplace-popover" id="picker-<%= key %>">
          <div class="picker-header">
            <div class="d-grid picker-heading-copy">
              <label for="search-<%= key %>"><%= label %></label>
              <div class="m-0 picker-selection-status">
                <span data-picker-selection-count><%= Array(params[key]).reject(&:blank?).any? ? "#{Array(params[key]).reject(&:blank?).size} selected" : "Add #{label.downcase}" %></span>
                <button type="button" class="picker-clear" aria-label="Clear selected <%= label.downcase %>" title="Clear selection" data-picker-clear data-action="marketplace-search#clearPicker" <%= "hidden" if Array(params[key]).reject(&:blank?).empty? %>><span aria-hidden="true">×</span></button>
              </div>
            </div>
            <button type="button" class="picker-close" aria-label="Close <%= label.downcase %>" data-action="marketplace-search#done"><span aria-hidden="true">×</span></button>
          </div>
          <input type="search" id="search-<%= key %>" placeholder="Find <%= label.downcase %>…" data-action="input->marketplace-search#filter">
          <div class="picker-match-mode">
            <p class="picker-match-label">Match recipes</p>
            <button type="button" data-mode="include" aria-pressed="<%= !only_available %>" data-action="marketplace-search#changeMode">
              <strong>Include these items</strong>
              <span>Recipes must contain your selections; other items are allowed.</span>
            </button>
            <button type="button" data-mode="only" aria-pressed="<%= only_available %>" data-action="marketplace-search#changeMode">
              <strong>Use only what I have</strong>
              <span>Recipes must use only your selected <%= label.downcase %>.</span>
            </button>
            <p class="picker-mode-hint" data-mode-hint <%= "hidden" unless only_available %>>Select all <%= label.downcase %> you have<%= ", including ice" if key == :ingredient_ids %>. Until you select one, this filter allows all <%= label.downcase %>.</p>
          </div>
          <div class="d-flex overflow-y-auto marketplace-options">
            <% items.each do |item| %>
              <label data-search-option>
                <%= check_box_tag "#{key}[]", item.id, Array(params[key]).map(&:to_s).include?(item.id.to_s), id: "search-#{key}-#{item.id}", data: { action: "change->marketplace-search#changeSelections", marketplace_search_target: "choice", label: item.display_name } %>
                <span><%= item.display_name %></span>
              </label>
            <% end %>
          </div>
          <p class="picker-empty" data-picker-empty hidden>No matching <%= label.downcase %>. Try another name.</p>
        </div>
      </details>
    <% end %>
    <div class="d-flex marketplace-submit-wrapper">
      <button type="submit" class="d-flex align-items-center justify-content-center p-0 marketplace-submit" aria-label="Search" title="Search">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
      </button>
    </div>
  </div>
  <p class="marketplace-feedback" role="status" data-marketplace-search-target="status" hidden></p>
  <div class="flex-wrap align-items-center marketplace-selection-row">
    <div class="flex-wrap marketplace-chips" data-marketplace-search-target="chips" aria-label="Selected filters"></div>
    <%= link_to "Clear all", root_path, class: "marketplace-clear" %>
  </div>
<% end %>
