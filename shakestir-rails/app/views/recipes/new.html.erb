<% content_for :title, "New recipe · ShakeStir" %>
<div class="library-page recipe-editor">
  <%= link_to my_recipes_path, class: "library-back" do %><%= render "collections/icon", name: "back" %>My recipes<% end %>
  <header class="library-heading"><div><h1>New recipe</h1><p class="library-description">Start with an idea. Refine it at your own pace.</p></div></header>
  <%= render "form", recipe: @recipe %>
</div>
